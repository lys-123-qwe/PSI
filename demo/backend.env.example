# Copy to backend.env on the Linux backend machine. backend.env is git-ignored.
#
# Absolute paths on that machine:
MYPSI_BIN=/home/you/psi-demo/myPSI-frontend-patched
MYPSI_LD_LIBRARY_PATH=/home/you/psi-demo/relic/build-linux/lib

# Keep 0.0.0.0 so the Windows demo can reach it; restrict 8787 by firewall.
HOST=0.0.0.0
PORT=8787
MYPSI_PATCHED=1
MYPSI_TIMEOUT=300

# Qin-3 protocol ports are MYPSI_PORT_BASE+12 / +13.
# Instance A (PORT=8787): 1200 -> 1212/1213.
# Instance B on the same Linux (PORT=8788): change to 1320 -> 1332/1333.
# Leave empty only if you want start.sh to derive a block from PORT.
MYPSI_PORT_BASE=1200
